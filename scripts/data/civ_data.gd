	"l33": ["Wak Chanil Ajaw", "maya", 24, "Nuova dinastia", "Ottiene +2 al combattimento se è entro 2 caselle da una tua città.", "Ricostruzione", "Dopo un'azione Muovi in cui ha conquistato una città: puoi rimuovere 1 edificio del tuo colore dalla sua città per costruirne uno diverso nella sua città (anche se Arrabbiata) senza costo in risorse e come azione gratuita."],
	"l32": ["Siyaj K'ak'", "maya", 25, "Nasce il fuoco", "1° round di combattimento: ottiene un bonus al combattimento pari alla dimensione della città che attacca.", "Afflusso culturale", "Dopo aver costruito un edificio o una Meraviglia nella sua città, puoi fare un tentativo di Influenza la cultura dalla sua città come azione gratuita."],
	"l31": ["K'inich Janaab' Pakal", "maya", 26, "Scudo del sole", "1° round di combattimento, rimuovendo le perdite: annulla un \"colpo\" se difende una città con un Obelisco del suo colore.", "Arte e architettura", "Quando costruisci un edificio nella sua città, paga 1 Cultura per ridurre il costo di 2 risorse qualsiasi."],
	"l30": ["Imperatrice Suiko", "japan", 27, "Buddhismo giapponese", "Come azione (o azione gratuita se hai Religione di Stato): paga 1 Cultura per cambiare nel tuo colore un pezzo influenzato (non un Obelisco) nella sua città. Non conta come tentativo di Influenza la cultura.", "Difensore", "Quando difende: ottiene +2 al combattimento."],
	"l10": ["Regina Boudicca", "celts", 28, "Impavida", "Ottiene +2 al combattimento contro giocatori con più avanzamenti di Guerra.", "Grandi numeri", "Quando è con un Colono che fonda una città, puoi pagare 1 Cibo per tenere il Colono."],
	"l11": ["Vercingetorige", "celts", 29, "Popolo guerriero", "Ottiene +1 al combattimento per ogni tuo Colono entro 2 caselle da lui.", "Reclutamento rapido", "Quando recluti unità nella sua città, puoi schierarle direttamente su caselle di terra adiacenti scoperte senza unità o città nemiche."],
	"l12": ["Viriato", "celts", 30, "Terrore", "Prima di ogni round di combattimento dopo il 1°: può costringere un'unità d'armata nemica della battaglia a spostarsi in una casella di terra adiacente senza città né unità. Paga 2 Umore.", "Lealtà", "Puoi giocare carte Azione per conto dei barbari che attaccano o difendono entro 2 caselle da lui."],
	"l13": ["Imperatrice Wu Zetian", "china", 31, "Agricola", "Come azione: se è in una città Felice puoi acquisire un avanzamento di Agricoltura per 1 Cultura o 1 Umore.", "Conquistatrice scaltra", "Ottiene +2 al combattimento se il suo esercito ha un numero di unità d'armata pari o superiore a quello nemico, subito prima del tiro di combattimento."],
	"l26": ["Ashoka il Grande", "india", 32, "Buddhismo", "Una volta per turno: la sua città può ripetere il tiro di Influenza la cultura se ha un Tempio o se cerca di influenzare un Tempio.", "Espansionista", "+1 Cultura quando conquista una città, o +2 Cultura se ha un Tempio."],
	"l27": ["Maharaja Sri Gupta", "india", 33, "Età dell'oro", "Azione gratuita: avanza in una nuova categoria attivando la sua città e pagando 1 Cultura oltre al costo in risorse.", "Preparato", "Ottiene +2 al combattimento in ogni round di combattimento in cui non giochi carte Azione."],
	"l28": ["Imperatore Go-Toba", "japan", 34, "Via della spada", "Prima che inizi una battaglia: paga 1 Minerale perché dia +2 al combattimento in ogni round per tutta la battaglia (anche se muore).", "Studioso", "Dopo aver costruito un'Accademia o un Osservatorio nella sua città, puoi acquisire un avanzamento come azione gratuita."],
	"l29": ["Imperatore Jimmu", "japan", 35, "Fortificato", "Le tue Fortezze ottengono +2 al combattimento in ogni round finché lui è entro 2 caselle da esse (anche se viene usata l'Assedio).", "Mitico", "Dopo aver combattuto ed essere sopravvissuto a una battaglia, puoi pagare 1 Cultura per riprendere una carta Azione spesa durante la battaglia."],
	"l06": ["Nebuchadnezzar II", "babylonia", 36, "Giardini pensili", "Quando peschi una Meraviglia devi, se possibile, scegliere i Grandi Giardini: cercali nel mazzo o negli scarti (rimescola) o prendili dal giocatore che ha la carta (che ne pesca un'altra). Qualsiasi Meraviglia può essere costruita nella sua città come azione gratuita, e i Grandi Giardini costano 2 Cultura in meno.", "Iconoclasta", "Ottiene +2 al combattimento quando attacca città con Tempio."],
	"l07": ["Annibale", "carthage", 37, "Padre della strategia", "1° round di combattimento: il suo nemico può ottenere al massimo +2 al combattimento in totale (ignora ogni bonus oltre questo).", "Hannibal ad portas", "Quando ci sono Elefanti con lui, tutto il suo gruppo può ignorare la penalità di movimento della Montagna."],
	"l08": ["Annone", "carthage", 38, "Navigatore", "Una volta per turno: come azione gratuita, può muovere con un gruppo di Navi se non hanno mosso in quel turno e non muovono di nuovo in quel turno.", "Comandante della flotta", "Mentre è su una Nave: dà +2 al combattimento nelle battaglie navali nella sua casella."],
	"l09": ["Regina Didone", "carthage", 39, "Fondatrice", "Quando è con un'unità che può fondare una città, l'unità può farlo come azione gratuita.", "Sacrificio", "Se la sua città è attaccata: ottiene +2 al combattimento. Dopo essere sopravvissuta a un round di combattimento, puoi costringere l'attaccante a ritirarsi scartandola (senza assegnare PV) e sostituendola con una Fanteria."],
	"l05": ["Nabopolassar", "babylonia", 40, "Liberatore", "Ottiene +2 al combattimento contro giocatori con un numero di città pari o superiore al tuo.", "Rivolta", "Dopo che una tua città è stata conquistata, piazza gratis una Fanteria con Nabopolassar (o in una tua città se il suo esercito ha raggiunto il limite di accatastamento)."],
	"l04": ["Hammurabi", "babylonia", 41, "Legislatore", "Aumenta la felicità: puoi portare la sua città direttamente a Felice pagando 1 Cultura invece del normale costo in Umore.", "Guardiano", "Costruire una Fortezza nella sua città non costa Cibo né Legno."],
	"l03": ["Marqzen", "aztecs", 42, "Signore delle tempeste", "Dopo che un Evento (non un'icona) riduce l'Umore o elimina unità non Leader nella sua città, può annullare il calo di Umore e riprendere alcune o tutte le unità perse nella sua città.", "Diffondere il terrore", "Una volta per turno: come azione, un'unità di terra nemica adiacente a lui può essere spostata di 1 casella di terra (senza che ne derivi una battaglia)."],
	"l02": ["Ahuitzotl", "aztecs", 43, "Espansionista", "Rimuovendo le perdite: può annullare un \"colpo\" se non ci sono città azteche entro 2 caselle da lui.", "Sacrificio di massa", "Una volta per turno: come azione gratuita, sacrifica 2 Prigionieri per costruire un edificio o una Meraviglia nella sua città al costo normale."],
	"l01": ["Acamapichtli", "aztecs", 44, "Crescita", "Quando costruisci un edificio o una Meraviglia nella sua città, ogni Prigioniero può essere speso come 2 risorse qualsiasi.", "Tributi", "Una volta per turno: come azione gratuita, paga 2 Umore per raccogliere dalla sua città se è di dimensione 3 o inferiore."],
}
